<?xml version="1.0" encoding="UTF-8"?>
<!--
  Unit tests: pure PHP, no Magento boot, no database. They cover the map validation and the CSV
  dialect, and run in CI. The engine itself is covered by Test/Integration (needs a Magento DB).
  From the module root:  vendor/bin/phpunit
-->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="Test/Unit/bootstrap.php"
         colors="true"
         failOnWarning="true">
    <testsuites>
        <testsuite name="Unit">
            <directory>Test/Unit</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory suffix=".php">.</directory>
        </include>
        <exclude>
            <directory>Test</directory>
            <directory>vendor</directory>
        </exclude>
    </source>
</phpunit>
