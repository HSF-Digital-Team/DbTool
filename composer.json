{
    "name": "ecomeu/module-dbtool",
    "description": "Module used to sync customers from prod to local, could be handy in some cases",
    "type": "magento2-module",
    "require": {
        "php": ">=8.3",
        "magento/framework": "*",
        "magento/magento-coding-standard": "*"
    },
    "require-dev": {
        "bitexpert/phpstan-magento": "^0.13",
        "phpstan/extension-installer": "^1.3",
        "phpstan/phpstan": "^1.9",
        "magento/module-catalog": "*",
        "magento/module-eav": "*",
        "magento/module-store": "*",
        "magento/module-quote": "*",
        "magento/module-sales": "*",
        "magento/module-cms": "*",
        "magento/module-customer": "*",
        "magento/module-config": "*",
        "psr/log": "*"
    },
    "config": {
        "allow-plugins": {
            "phpstan/extension-installer": true
        }
    },
    "license": [
        "Proprietary"
    ],
    "autoload": {
        "files": [
            "registration.php"
        ],
        "psr-4": {
            "EcomEU\\DbTool\\": ""
        }
    }
}
